# FORMADOS · /api/inscripcion — variables de entorno (Vercel → Project Settings → Environment Variables)
# Nunca commitear un .env real. Este archivo es solo referencia de nombres.

# Registro de aplicación en Entra ID (permisos de aplicación, no delegados):
#   Sites.Selected o Sites.ReadWrite.All (acotado al sitio del ministerio) + Mail.Send
FORMADOS_TENANT_ID=
FORMADOS_CLIENT_ID=
FORMADOS_CLIENT_SECRET=

# Sitio y lista de SharePoint donde se crea un elemento por persona
FORMADOS_SP_SITE_ID=
FORMADOS_SP_LIST_ID=

# Buzón compartido desde el que se envían confirmaciones y avisos (requiere Mail.Send)
FORMADOS_SENDER_MAILBOX=

# Correos de los líderes de cada pista, para el aviso de nueva inscripción
FORMADOS_LIDER_KIDS=
FORMADOS_LIDER_NEXTGEN=
FORMADOS_LIDER_ADULTOS=

# Sitio principal · /api/sermons — sincroniza la sección "Prédicas" con YouTube
# Sin esta key, el sitio sigue funcionando con el respaldo manual de content.js.
#
# Cómo obtenerla:
#   1. https://console.cloud.google.com/ → crear proyecto (o usar uno existente)
#   2. "APIs y servicios" → "Biblioteca" → buscar "YouTube Data API v3" → Habilitar
#   3. "APIs y servicios" → "Credenciales" → "Crear credenciales" → "Clave de API"
#   4. Restringe la key a "YouTube Data API v3" (recomendado, evita mal uso)
YOUTUBE_API_KEY=

# Handle del canal sin el "@" (opcional, por defecto "mundodefesd")
YOUTUBE_HANDLE=mundodefesd

# Solo se muestran videos cuyo título matchee este patrón (opcional,
# por defecto "servicio dominical") — así no se cuelan devocionales,
# clips u otro contenido que también se suba al canal.
SERMONS_TITLE_FILTER=servicio dominical
